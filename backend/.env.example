# ValiBread Backend - Variáveis de Ambiente
PORT=3000

# URL do seu projeto Supabase (ex: https://xyz.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# IMPORTANTE: Use a chave "service_role" (secreta) e NÃO a "anon" (pública).
# A chave "anon" é restrita por RLS e bloqueia operações de INSERT/DELETE de produtos, lotes e pacotes.
SUPABASE_KEY=sua_supabase_service_role_key_aqui

# Segredo para assinatura de tokens JWT
JWT_SECRET=uma_chave_jwt_longa_e_segura_aqui

# Chave de API para autenticação de leitores de hardware RFID (ESP32)
RFID_API_KEY=chave_segura_para_o_hardware_rfid

