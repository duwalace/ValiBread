# ValiBread Backend - Variáveis de Ambiente
PORT=3000

# String de conexão com o PostgreSQL (Azure Database for PostgreSQL)
DATABASE_URL=postgres://usuario:senha@seu-servidor-azure.postgres.database.azure.com:5432/valibread?sslmode=require

# Azure Blob Storage (opcional para persistência de relatórios gerados)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=seu_storage_account;AccountKey=sua_chave;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=chatbot-exports

# Segredo para assinatura de tokens JWT
JWT_SECRET=uma_chave_jwt_longa_e_segura_aqui

# Chave de API para autenticação de leitores de hardware RFID (ESP32)
RFID_API_KEY=chave_segura_para_o_hardware_rfid
